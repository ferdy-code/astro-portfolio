---
import StatusDot from "../visuals/StatusDot.astro";

const links = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<footer class="relative border-t border-line bg-ink-2/60">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-heading text-base font-semibold tracking-tight text-fg">Alex Morgan</p>
        <p class="mt-1 font-mono text-[11px] tracking-[0.18em] text-fg-muted uppercase">
          Solo Product Engineer
        </p>
        <p class="mt-4 inline-flex items-center gap-2 text-sm text-fg-muted">
          <StatusDot label="Open to interesting projects" />
          Open to interesting projects
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-3">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-fg-muted transition-colors duration-200 hover:text-fg"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 border-t border-line pt-6">
      <p class="font-mono text-xs text-fg-muted">© 2026 Alex Morgan. Built with intention.</p>
    </div>
  </div>
</footer>
