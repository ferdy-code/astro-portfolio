---
import Button from "../ui/Button.astro";

const links = [
  { label: "About", href: "#about" },
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header data-navbar class="navbar fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="#top" class="flex items-baseline gap-2.5">
      <span class="font-heading text-base font-semibold tracking-tight text-fg">Ferdy</span>
      <span
        class="hidden font-mono text-[11px] tracking-[0.18em] text-fg-muted uppercase sm:inline"
      >
        AI-Powered Fullstack Developer
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-fg-muted transition-colors duration-200 hover:text-fg"
          >
            {link.label}
          </a>
        ))
      }
      <Button href="#contact" size="sm">Let&apos;s Talk</Button>
    </nav>

    <button
      data-menu-toggle
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
      class="flex h-9 w-9 flex-col items-center justify-center gap-1.5 rounded-md border border-line bg-white/[0.02] lg:hidden"
    >
      <span class="menu-bar" aria-hidden="true"></span>
      <span class="menu-bar" aria-hidden="true"></span>
    </button>
  </div>

  <div id="mobile-menu" data-menu class="menu lg:hidden">
    <div class="menu-inner">
      <nav aria-label="Mobile" class="mx-auto flex max-w-6xl flex-col gap-1 px-6 pt-2 pb-6">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-lg px-3 py-2.5 text-sm text-fg-muted transition-colors hover:bg-white/5 hover:text-fg"
            >
              {link.label}
            </a>
          ))
        }
        <Button href="#contact" size="sm" class="mt-3 w-full">Let&apos;s Talk</Button>
      </nav>
    </div>
  </div>
</header>

<style>
  .navbar {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .navbar.is-scrolled {
    background: rgb(10 11 14 / 0.72);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-line);
  }

  .menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .menu.open {
    grid-template-rows: 1fr;
    background: rgb(10 11 14 / 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  .menu-inner {
    min-height: 0;
    overflow: hidden;
  }

  .menu-bar {
    width: 16px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--color-fg-muted);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  button[aria-expanded="true"] .menu-bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
    background: var(--color-fg);
  }

  button[aria-expanded="true"] .menu-bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
    background: var(--color-fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu-bar,
    .navbar {
      transition: none;
    }
  }
</style>

<script>
  function initNavbar() {
    const header = document.querySelector<HTMLElement>("[data-navbar]");
    if (!header || header.dataset.navbarBound) return;
    header.dataset.navbarBound = "true";

    const update = () => header.classList.toggle("is-scrolled", window.scrollY > 24);
    update();
    window.addEventListener("scroll", update, { passive: true });

    const toggle = header.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = header.querySelector<HTMLElement>("[data-menu]");
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("open", open);
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true")
    );
    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  initNavbar();
  document.addEventListener("astro:after-swap", initNavbar);
</script>
