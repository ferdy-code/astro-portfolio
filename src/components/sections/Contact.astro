---
import Mail from "@lucide/astro/icons/mail";
import Reveal from "../ui/Reveal.astro";
import GlassPanel from "../ui/GlassPanel.astro";
import Button from "../ui/Button.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import StatusDot from "../visuals/StatusDot.astro";
import NodeNetwork from "../visuals/NodeNetwork.astro";
import GlowLine from "../visuals/GlowLine.astro";

const email = "hello@alexmorgan.dev";
---

<section id="contact" class="relative mx-auto max-w-6xl scroll-mt-24 px-6 pb-28">
  <Reveal>
    <GlassPanel class="relative overflow-hidden px-6 py-16 text-center sm:px-16 sm:py-20">
      <NodeNetwork class="absolute inset-0 opacity-40" />
      <div class="absolute inset-x-16 top-0">
        <GlowLine />
      </div>

      <div class="relative mx-auto max-w-2xl">
        <p class="font-mono text-xs font-medium tracking-[0.25em] text-accent-cyan uppercase">
          Contact
        </p>

        <h2 class="mt-4 font-heading font-semibold tracking-tight text-balance text-fg text-[clamp(2.25rem,5vw,3.25rem)]">
          Have an idea <span class="text-gradient">worth building</span>?
        </h2>

        <p class="mt-6 leading-relaxed text-pretty text-fg-muted">
          The best products come from people who care about the whole picture — the idea, the
          interface, and the system underneath it. Tell me what you&apos;re working on, and
          let&apos;s find out if we&apos;re a fit.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
          <Button href={`mailto:${email}`} size="lg">
            <Mail size={16} />
            Start a conversation
          </Button>
          <a
            href={`mailto:${email}`}
            class="font-mono text-sm text-fg-muted underline decoration-line underline-offset-4 transition-colors hover:text-fg"
          >
            {email}
          </a>
        </div>

        <div class="mt-9 flex items-center justify-center gap-3">
          <SocialIcon name="github" label="Alex Morgan on GitHub" href="https://github.com/alexmorgan" />
          <SocialIcon name="linkedin" label="Alex Morgan on LinkedIn" href="https://linkedin.com/in/alexmorgan" />
          <SocialIcon name="x" label="Alex Morgan on X" href="https://x.com/alexmorgan" />
        </div>

        <p class="mt-8 inline-flex items-center gap-2 font-mono text-[11px] tracking-wide text-fg-muted">
          <StatusDot label="Open to interesting projects" />
          Open to interesting projects
        </p>
      </div>
    </GlassPanel>
  </Reveal>
</section>
