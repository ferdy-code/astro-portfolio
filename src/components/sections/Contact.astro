---
import Mail from "@lucide/astro/icons/mail";
import Reveal from "../ui/Reveal.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import StatusDot from "../visuals/StatusDot.astro";
import NodeNetwork from "../visuals/NodeNetwork.astro";

const email = "mferdy61@gmail.com";
---

<section id="contact" class="relative mx-auto max-w-6xl scroll-mt-24 px-6 pb-28">
  <Reveal>
    <Card class="relative overflow-hidden px-6 py-16 text-center sm:px-16 sm:py-20">
      <NodeNetwork class="absolute inset-0 opacity-40" />
      <div class="relative mx-auto max-w-2xl">
        <p class="font-mono text-sm text-fg-muted">Contact</p>

        <h2 class="mt-4 font-heading font-semibold tracking-tight text-balance text-fg text-[clamp(2.25rem,5vw,3.25rem)]">
          Building something that needs an LLM?
        </h2>

        <p class="mt-6 leading-relaxed text-pretty text-fg-muted">
          Send me a short note about what you&apos;re building and where you&apos;re stuck.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
          <Button href={`mailto:${email}`} size="lg">
            <Mail size={16} />
            Email me
          </Button>
          <a
            href={`mailto:${email}`}
            class="inline-flex min-h-11 items-center font-mono text-sm text-fg-muted underline decoration-line underline-offset-4 transition-colors hover:text-fg"
          >
            {email}
          </a>
        </div>

        <div class="mt-9 flex items-center justify-center gap-3">
          <SocialIcon name="linkedin" label="Ferdy on LinkedIn" href="https://www.linkedin.com/in/muhammad-ferdy-081521149/" />
          <SocialIcon name="@" label="Ferdy on Threads" href="https://www.threads.com/@muhferdya" />
          <SocialIcon name="github" label="Ferdy on GitHub" href="https://github.com/ferdy-code" />
        </div>

        <p class="mt-8 inline-flex items-center gap-2 font-mono text-xs text-fg-muted">
          <StatusDot label="Building in public" />
          Building in public
        </p>
      </div>
    </Card>
  </Reveal>
</section>
