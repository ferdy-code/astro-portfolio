---
import ChevronDown from "@lucide/astro/icons/chevron-down";
import Button from "../ui/Button.astro";
import Reveal from "../ui/Reveal.astro";
import StatusDot from "../visuals/StatusDot.astro";
import PortraitScene from "../visuals/PortraitScene.astro";
---

<section class="relative mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 pt-28 pb-20">
  <div class="grid items-center gap-16 lg:grid-cols-2">
    <div>
      <Reveal>
        <h1
          class="font-heading leading-[1.05] font-semibold tracking-tight text-balance text-fg text-[clamp(2.75rem,6.5vw,4.5rem)]"
        >
          Fullstack apps with <span class="text-gradient">RAG and agents</span> built in from the start.
        </h1>
      </Reveal>

      <Reveal delay={80}>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-pretty text-fg-muted">
          I&apos;m Ferdy, a developer in Indonesia. At work I build front ends in Vue and Nuxt.
          On my own projects I go fullstack: a RAG assistant for Indonesian documents, and four
          AI agents running on Telegram.
        </p>
      </Reveal>

      <Reveal delay={140}>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="#projects">See what I&apos;m building</Button>
          <Button href="#contact" variant="ghost">Let&apos;s talk</Button>
        </div>
      </Reveal>

      <Reveal delay={200}>
        <div
          class="mt-9 inline-flex items-center gap-2.5 rounded-full border border-line bg-white/[0.03] px-4 py-2"
        >
          <StatusDot label="Building in public" />
          <span class="font-mono text-xs text-fg-muted">
            Building in public
          </span>
        </div>
      </Reveal>
    </div>

    <Reveal delay={200} class="relative mx-auto w-full max-w-md lg:max-w-none">
      <PortraitScene />
    </Reveal>
  </div>

  <a
    href="#projects"
    aria-label="Scroll to Projects section"
    class="absolute bottom-7 left-1/2 hidden min-h-11 min-w-11 -translate-x-1/2 flex-col items-center justify-center gap-1 text-fg-muted transition-colors hover:text-fg md:flex"
  >
    <span class="font-mono text-xs">Scroll</span>
    <ChevronDown size={14} class="animate-float" />
  </a>
</section>
