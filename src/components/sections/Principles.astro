---
import Reveal from "../ui/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const principles = [
  { number: "01", text: "**Ship &gt; Study.** Build first, learn by doing." },
  {
    number: "02",
    text: "**Depth over breadth.** Go deep on RAG and agents rather than spreading thin across every AI subfield.",
  },
  { number: "03", text: "AI should take the busywork, so **engineers keep the judgment calls**." },
  {
    number: "04",
    text: "Product work and personal brand should **feed each other**. Building in public is how I do that.",
  },
];

const highlight = (text: string) =>
  text.replace(/\*\*(.+?)\*\*/g, '<span class="text-fg">$1</span>');
---

<section class="relative mx-auto max-w-6xl px-6 py-24 sm:py-28">
  <Reveal>
    <SectionHeading eyebrow="Principles" title="How I work." />
  </Reveal>

  <div class="mt-6">
    {
      principles.map((principle, i) => (
        <Reveal delay={i * 100}>
          <div class="border-b border-line py-8 sm:py-10">
            <div class="flex items-baseline gap-6 sm:gap-10">
              <span class="font-mono text-xs text-fg-muted">{principle.number}</span>
              <p
                class="font-heading text-2xl leading-snug font-semibold tracking-tight text-balance text-fg-muted sm:text-3xl lg:text-4xl"
                set:html={highlight(principle.text)}
              />
            </div>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
