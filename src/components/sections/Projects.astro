---
import { getCollection } from "astro:content";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Reveal from "../ui/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TechTag from "../ui/TechTag.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import StatusDot from "../visuals/StatusDot.astro";
import InvoicePreview from "../visuals/previews/InvoicePreview.astro";
import RagPreview from "../visuals/previews/RagPreview.astro";
import AgentsPreview from "../visuals/previews/AgentsPreview.astro";
import PresensiPreview from "../visuals/previews/PresensiPreview.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const previews: Record<string, typeof InvoicePreview> = {
  invoicekit: InvoicePreview,
  "rag-assistant": RagPreview,
  "ai-agents": AgentsPreview,
  presensi: PresensiPreview,
};
---

<section id="projects" class="relative mx-auto max-w-6xl scroll-mt-24 px-6 py-24 sm:py-28">
  <Reveal>
    <SectionHeading
      eyebrow="Selected Work"
      title="What I'm building."
      subtitle="A mix of shipped, in-progress, and in-planning — status labeled honestly."
    />
  </Reveal>

  <div class="mt-16 space-y-10">
    {
      projects.map((project, i) => {
        const Preview = previews[project.id];
        const reversed = i % 2 === 1;
        return (
          <Reveal delay={80}>
            <article class="group grid items-center gap-8 rounded-2xl border border-line bg-surface/50 p-6 transition-all duration-200 hover:-translate-y-1 hover:border-accent/30 hover:shadow-[0_16px_60px_-20px_var(--color-glow)] sm:p-8 lg:grid-cols-2 lg:gap-12">
              <div class:list={[reversed && "lg:order-2"]}>
                <p class="font-mono text-sm text-accent-cyan">{project.data.number}</p>
                <h3 class="mt-2 font-heading text-2xl font-semibold tracking-tight text-fg sm:text-3xl">
                  {project.data.title}
                </h3>
                <p class="mt-3 leading-relaxed text-pretty text-fg-muted">
                  {project.data.description}
                </p>

                <div class="mt-5 flex flex-wrap gap-2">
                  {project.data.tags.map((tag) => (
                    <TechTag>{tag}</TechTag>
                  ))}
                </div>

                <p class="mt-4 inline-flex items-center gap-2 font-mono text-[11px] tracking-wide text-fg-muted">
                  <StatusDot label={project.data.status} />
                  {project.data.status}
                </p>

                <div class="mt-7 flex items-center gap-5">
                  <a
                    href={`/projects/${project.id}`}
                    class="inline-flex items-center gap-1.5 text-sm font-medium text-fg transition-colors hover:text-accent-cyan"
                  >
                    View Case Study
                    <ArrowRight size={15} class="transition-transform duration-200 group-hover:translate-x-0.5" />
                  </a>
                  {project.data.github && (
                    <SocialIcon
                      name="github"
                      label={`${project.data.title} on GitHub`}
                      href={project.data.github}
                      class="h-8 w-8"
                    />
                  )}
                </div>
              </div>

              <div
                class:list={[
                  "relative aspect-[16/10] overflow-hidden rounded-xl border border-line bg-gradient-to-br",
                  project.data.gradient,
                  reversed && "lg:order-1",
                ]}
              >
                <div class="absolute inset-0 transition-transform duration-300 group-hover:scale-[1.02] group-hover:-translate-y-0.5">
                  {Preview && <Preview class="h-full w-full" />}
                </div>
              </div>
            </article>
          </Reveal>
        );
      })
    }
  </div>
</section>
