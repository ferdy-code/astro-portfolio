---
import { cn } from "../../lib/utils";

interface Props {
  tone?: "default" | "accent";
  class?: string;
  [key: string]: unknown;
}

const { tone = "default", class: className, ...rest } = Astro.props;

const tones = {
  default: "border-line bg-white/[0.03] text-fg-muted",
  accent: "border-accent/30 bg-accent/10 text-accent-cyan",
};
---

<span
  class:list={cn(
    "inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 font-mono text-[11px] leading-5 tracking-wide",
    tones[tone],
    className
  )}
  {...rest}
>
  <slot />
</span>
