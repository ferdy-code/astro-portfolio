---
import { cn } from "../../lib/utils";

interface Props {
  hoverable?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { hoverable = false, class: className, ...rest } = Astro.props;
---

<div
  class:list={cn(
    "rounded-xl border border-line bg-surface/70",
    hoverable && "transition-colors duration-200 hover:border-white/[0.16]",
    className
  )}
  {...rest}
>
  <slot />
</div>
