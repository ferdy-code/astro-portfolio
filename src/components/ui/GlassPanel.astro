---
import { cn } from "../../lib/utils";

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<div
  class:list={cn(
    "rounded-xl border border-line bg-white/[0.03] shadow-[0_1px_0_0_rgb(255_255_255/0.04)_inset] backdrop-blur-md",
    className
  )}
  {...rest}
>
  <slot />
</div>
