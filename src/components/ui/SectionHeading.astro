---
import { cn } from "../../lib/utils";

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, subtitle, align = "left", class: className } = Astro.props;
---

<div class:list={cn("max-w-2xl", align === "center" && "mx-auto text-center", className)}>
  {
    eyebrow && (
      <p class="font-mono text-xs font-medium tracking-[0.2em] text-accent-cyan uppercase">
        {eyebrow}
      </p>
    )
  }
  <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight text-balance text-fg sm:text-4xl">
    <slot>{title}</slot>
  </h2>
  {
    subtitle && (
      <p class="mt-3 text-base leading-relaxed text-pretty text-fg-muted">{subtitle}</p>
    )
  }
</div>
