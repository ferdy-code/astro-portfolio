---
import { cn } from "../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div aria-hidden="true" class={cn("pointer-events-none fixed inset-0 -z-10", className)}>
  <div class="grid-lines absolute inset-0"></div>
  <div
    class="absolute -top-48 left-1/2 h-[480px] w-[720px] -translate-x-1/2 rounded-full bg-accent/10 blur-[140px]"
  >
  </div>
  <div
    class="absolute -right-32 -bottom-56 h-[420px] w-[520px] rounded-full bg-accent-cyan/[0.06] blur-[130px]"
  >
  </div>
  <div
    class="absolute top-1/3 -left-40 h-[360px] w-[440px] rounded-full bg-accent/[0.05] blur-[120px]"
  >
  </div>
</div>

<style>
  .grid-lines {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 25%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, black 25%, transparent 78%);
  }
</style>
