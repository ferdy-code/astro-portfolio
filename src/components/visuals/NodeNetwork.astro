---
import { cn } from "../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const nodes = [
  { x: 90, y: 420 },
  { x: 230, y: 180 },
  { x: 430, y: 300 },
  { x: 640, y: 130 },
  { x: 780, y: 390 },
  { x: 540, y: 470 },
  { x: 320, y: 500 },
];

const edges: Array<[number, number]> = [
  [0, 1],
  [1, 2],
  [2, 3],
  [3, 4],
  [2, 4],
  [2, 5],
  [5, 6],
  [0, 6],
];
---

<svg
  viewBox="0 0 900 560"
  fill="none"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  class={cn("pointer-events-none h-full w-full select-none", className)}
>
  <defs>
    <linearGradient id="nn-line" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3B82F6" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#22D3EE" stop-opacity="0.2"></stop>
    </linearGradient>
  </defs>

  {
    edges.map(([a, b], i) => (
      <line
        x1={nodes[a].x}
        y1={nodes[a].y}
        x2={nodes[b].x}
        y2={nodes[b].y}
        stroke="url(#nn-line)"
        stroke-width="1"
        stroke-dasharray={i % 3 === 0 ? "3 6" : undefined}
        class={i % 3 === 0 ? "animate-dash-flow" : undefined}
      />
    ))
  }

  {
    nodes.map((n, i) => (
      <circle
        cx={n.x}
        cy={n.y}
        r={i % 3 === 0 ? 3.5 : 2.5}
        fill={i % 2 === 0 ? "#3B82F6" : "#22D3EE"}
        class="animate-node-glow"
        style={`animation-delay:${(i * 0.9).toFixed(1)}s`}
      />
    ))
  }
</svg>
