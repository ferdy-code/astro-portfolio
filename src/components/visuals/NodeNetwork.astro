---
import { cn } from "../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const nodes = [
  { x: 90, y: 420 },
  { x: 230, y: 180 },
  { x: 430, y: 300 },
  { x: 640, y: 130 },
  { x: 780, y: 390 },
  { x: 540, y: 470 },
  { x: 320, y: 500 },
];

const edges: Array<[number, number]> = [
  [0, 1],
  [1, 2],
  [2, 3],
  [3, 4],
  [2, 4],
  [2, 5],
  [5, 6],
  [0, 6],
];

// Fixed per-node drift so every render moves the same way: amplitude in viewBox units, speed in rad/s.
const drift = nodes.map((n, i) => ({
  x: n.x,
  y: n.y,
  ax: 24 + ((i * 7) % 4) * 6,
  ay: 18 + ((i * 5) % 3) * 7,
  s: 0.28 + ((i * 3) % 5) * 0.05,
  p: i * 1.3,
}));
---

<svg
  data-node-network
  data-drift={JSON.stringify(drift)}
  viewBox="0 0 900 560"
  fill="none"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  class={cn("pointer-events-none h-full w-full select-none", className)}
>
  <defs>
    <!-- userSpaceOnUse: bounding-box gradients vanish when a moving line passes through horizontal/vertical -->
    <linearGradient id="nn-line" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="900" y2="560">
      <stop offset="0" stop-color="#3B82F6" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#22D3EE" stop-opacity="0.2"></stop>
    </linearGradient>
  </defs>

  {
    edges.map(([a, b], i) => (
      <line
        data-a={a}
        data-b={b}
        x1={nodes[a].x}
        y1={nodes[a].y}
        x2={nodes[b].x}
        y2={nodes[b].y}
        stroke="url(#nn-line)"
        stroke-width="1"
        stroke-dasharray={i % 3 === 0 ? "3 6" : undefined}
        class={i % 3 === 0 ? "animate-dash-flow" : undefined}
      />
    ))
  }

  {
    nodes.map((n, i) => (
      <circle
        data-i={i}
        cx={n.x}
        cy={n.y}
        r={i % 3 === 0 ? 3.5 : 2.5}
        fill={i % 2 === 0 ? "#3B82F6" : "#22D3EE"}
        class="animate-node-glow"
        style={`animation-delay:${(i * 0.9).toFixed(1)}s`}
      />
    ))
  }
</svg>

<script>
  type Drift = { x: number; y: number; ax: number; ay: number; s: number; p: number };

  function initNodeNetworks() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document
      .querySelectorAll<SVGSVGElement>("[data-node-network]:not([data-nn-bound])")
      .forEach((svg) => {
        svg.dataset.nnBound = "true";
        const drift: Drift[] = JSON.parse(svg.dataset.drift ?? "[]");
        const circles = [...svg.querySelectorAll<SVGCircleElement>("circle[data-i]")];
        const lines = [...svg.querySelectorAll<SVGLineElement>("line[data-a]")];

        let raf = 0;
        let last = 0;
        let t = 0;

        const frame = (now: number) => {
          // Cap the step so returning from a background tab doesn't make nodes jump.
          if (last) t += Math.min((now - last) / 1000, 0.05);
          last = now;

          const pos = drift.map((n) => [
            n.x + Math.sin(t * n.s + n.p) * n.ax,
            n.y + Math.cos(t * n.s * 0.8 + n.p) * n.ay,
          ]);

          for (const c of circles) {
            const [x, y] = pos[Number(c.dataset.i)];
            c.setAttribute("cx", x.toFixed(1));
            c.setAttribute("cy", y.toFixed(1));
          }
          for (const l of lines) {
            const [x1, y1] = pos[Number(l.dataset.a)];
            const [x2, y2] = pos[Number(l.dataset.b)];
            l.setAttribute("x1", x1.toFixed(1));
            l.setAttribute("y1", y1.toFixed(1));
            l.setAttribute("x2", x2.toFixed(1));
            l.setAttribute("y2", y2.toFixed(1));
          }

          raf = requestAnimationFrame(frame);
        };

        new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting && !raf) {
            raf = requestAnimationFrame(frame);
          } else if (!entry.isIntersecting && raf) {
            cancelAnimationFrame(raf);
            raf = 0;
            last = 0;
          }
        }).observe(svg);
      });
  }

  initNodeNetworks();
  document.addEventListener("astro:after-swap", initNodeNetworks);
</script>
