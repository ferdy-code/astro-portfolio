---
import Card from "../ui/Card.astro";
import TechTag from "../ui/TechTag.astro";
---

<div aria-hidden="true" class="relative mx-auto aspect-[4/5] w-full max-w-md">
  <div
    class="absolute inset-x-6 inset-y-0 overflow-hidden rounded-2xl border border-line bg-gradient-to-b from-surface-2/80 to-ink-2/40"
  >
    <svg viewBox="0 0 200 250" class="absolute inset-x-0 bottom-0 h-full w-full text-fg-muted" fill="none" preserveAspectRatio="xMidYMax slice">
      <circle cx="100" cy="92" r="40" fill="currentColor" fill-opacity="0.18"></circle>
      <path
        d="M100 142c-46 0-74 32-78 76v32h156v-32c-4-44-32-76-78-76Z"
        fill="currentColor"
        fill-opacity="0.12"></path>
    </svg>
  </div>

  <Card class="absolute -left-4 top-10 w-44 animate-float bg-surface p-3 sm:-left-8">
    <div class="font-mono text-[10px] leading-[1.35]">
      <p>
        <span class="text-accent">const</span>
        <span class="text-fg">ship</span>
        <span class="text-fg-muted">=</span>
        <span class="text-accent">async</span>
        <span class="text-fg-muted">() =&gt; {"{"}</span>
      </p>
      <p class="pl-3 text-fg-muted">await <span class="text-fg">build</span>(idea);</p>
      <p><span class="text-fg-muted">{"}"};</span></p>
    </div>
  </Card>

  <Card class="absolute -right-2 top-1/4 w-36 animate-float-slow bg-surface p-3 sm:-right-6" style="animation-delay:-3s;">
    <p class="font-mono text-[10px] text-fg-muted">RAG pipeline</p>
    <div class="mt-2 flex items-center gap-1.5">
      <span class="h-1.5 w-1.5 rounded-full bg-fg-muted"></span>
      <span class="h-px flex-1 bg-line"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-fg-muted"></span>
      <span class="h-px flex-1 bg-line"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-fg-muted"></span>
    </div>
    <div class="mt-2 flex justify-between font-mono text-[9px] text-fg-muted">
      <span>embed</span><span>retrieve</span><span>answer</span>
    </div>
  </Card>

  <Card class="absolute -bottom-4 right-4 animate-float bg-surface p-3" style="animation-delay:-5s;">
    <div class="flex flex-wrap gap-1.5">
      <TechTag class="!text-[9px]">Vue</TechTag>
      <TechTag class="!text-[9px]">Nuxt</TechTag>
      <TechTag class="!text-[9px]">TypeScript</TechTag>
      <TechTag class="!text-[9px]">Next.js</TechTag>
      <TechTag class="!text-[9px]">Claude API</TechTag>
    </div>
  </Card>
</div>
