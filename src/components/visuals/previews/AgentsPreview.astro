---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const agents = [
  { name: "Kuma", role: "Japanese tutor" },
  { name: "Coach Rex", role: "English/IELTS" },
  { name: "Coach Titan", role: "Fitness coach" },
  { name: "Sora", role: "Social media" },
];
---

<div aria-hidden="true" class={cn("flex h-full flex-col rounded-md bg-ink/80 p-3 text-[10px]", className)}>
  <p class="border-b border-line pb-2 font-medium text-fg">Chats</p>

  <div class="mt-1 flex-1 divide-y divide-line">
    {
      agents.map((agent) => (
        <div class="flex items-center gap-2.5 py-1.5">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-line bg-white/[0.04] font-medium text-fg">
            {agent.name.split(" ").pop()?.charAt(0)}
          </span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-fg">{agent.name}</span>
            <span class="block truncate text-fg-muted">{agent.role}</span>
          </span>
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
        </div>
      ))
    }
  </div>
</div>
