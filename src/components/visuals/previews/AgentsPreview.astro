---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const agents = [
  { name: "Kuma", role: "Japanese tutor" },
  { name: "Coach Rex", role: "English/IELTS" },
  { name: "Coach Titan", role: "Fitness coach" },
  { name: "Sora", role: "Social media" },
];
---

<div aria-hidden="true" class={cn("flex h-full flex-col rounded-md bg-ink/80 p-3 font-mono text-[9px] leading-relaxed", className)}>
  <div class="flex items-center gap-1.5 border-b border-line pb-2">
    <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
    <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
    <span class="h-1.5 w-1.5 rounded-full bg-white/20"></span>
    <span class="ml-2 text-fg-muted">agents — telegram</span>
  </div>

  <div class="mt-2 flex-1 space-y-1.5">
    {
      agents.map((agent) => (
        <p class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400" />
          <span class="text-fg">{agent.name}</span>
          <span class="text-fg-muted">{agent.role}</span>
        </p>
      ))
    }
  </div>

  <p class="flex items-center gap-2 border-t border-line pt-2">
    <span class="text-accent-cyan">➜</span>
    <span class="text-fg">4 agents online</span>
    <span class="inline-block h-3 w-1.5 animate-pulse bg-accent-cyan"></span>
  </p>
</div>
