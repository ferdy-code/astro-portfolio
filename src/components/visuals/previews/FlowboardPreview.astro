---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const columns = [
  {
    title: "In progress",
    cards: [
      { w: "w-3/4", accent: false },
      { w: "w-1/2", accent: true },
    ],
  },
  {
    title: "Review",
    cards: [{ w: "w-2/3", accent: false }],
  },
  {
    title: "Done",
    cards: [
      { w: "w-3/5", accent: false },
      { w: "w-4/5", accent: false },
    ],
  },
];
---

<div aria-hidden="true" class={cn("flex h-full gap-2 p-3", className)}>
  <div class="hidden w-1/5 flex-col gap-2 rounded-md border border-line bg-white/[0.02] p-2 sm:flex">
    <span class="mb-1 h-1.5 w-8 rounded-full bg-accent/50"></span>
    <span class="h-1 w-full rounded-full bg-white/10"></span>
    <span class="h-1 w-5/6 rounded-full bg-white/[0.07]"></span>
    <span class="h-1 w-full rounded-full bg-white/[0.07]"></span>
    <span class="h-1 w-2/3 rounded-full bg-white/[0.07]"></span>
  </div>

  <div class="grid flex-1 grid-cols-3 gap-2">
    {
      columns.map((col) => (
        <div class="flex flex-col gap-1.5 rounded-md border border-line bg-white/[0.02] p-1.5">
          <span class="px-0.5 font-mono text-[8px] tracking-wider text-fg-muted uppercase">
            {col.title}
          </span>
          {col.cards.map((card) => (
            <div
              class:list={[
                "rounded border bg-white/[0.04] p-1.5",
                card.accent ? "border-accent/40" : "border-transparent",
              ]}
            >
              <span class:list={["block h-1 rounded-full bg-white/25", card.w]} />
              <span class="mt-1 block h-1 w-1/3 rounded-full bg-white/10" />
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>
