---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const rows = [
  { w: "w-3/4" },
  { w: "w-1/2" },
  { w: "w-2/3" },
];
---

<div aria-hidden="true" class={cn("flex h-full flex-col gap-2.5 p-4", className)}>
  <div class="flex items-center justify-between rounded-md border border-line bg-white/[0.03] px-3 py-2">
    <span class="font-mono text-[9px] tracking-[0.15em] text-accent-cyan uppercase">Faktur Pajak</span>
    <span class="rounded-sm border border-line bg-white/[0.03] px-1.5 py-0.5 font-mono text-[7px] tracking-wider text-fg-muted uppercase">
      Coretax
    </span>
  </div>

  <div class="flex items-center justify-between rounded-md border border-line bg-white/[0.02] px-3 py-2">
    <span class="font-mono text-[8px] tracking-wider text-fg-muted uppercase">NPWP</span>
    <span class="h-1 w-16 rounded-full bg-white/15"></span>
  </div>

  <div class="flex-1 space-y-1.5 rounded-md border border-line bg-white/[0.02] p-2.5">
    {
      rows.map((row) => (
        <div class="flex items-center gap-2">
          <span class:list={["h-1 rounded-full bg-white/10", row.w]} />
          <span class="ml-auto h-1 w-8 rounded-full bg-white/[0.07]" />
        </div>
      ))
    }
  </div>

  <div class="flex items-center justify-between rounded-md border border-accent/30 bg-accent/10 px-3 py-2">
    <span class="font-mono text-[8px] tracking-wider text-fg-muted uppercase">Total</span>
    <span class="font-mono text-[11px] text-accent-cyan">Rp ---</span>
  </div>
</div>
