---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const features = ["Auth & teams", "Stripe billing", "Marketing site"];
---

<div aria-hidden="true" class={cn("relative flex h-full flex-col p-3", className)}>
  <div class="flex items-center justify-between rounded-t-md border border-b-0 border-line bg-white/[0.03] px-3 py-1.5">
    <span class="flex items-center gap-1.5">
      <span class="h-2 w-2 rounded-sm bg-accent"></span>
      <span class="h-1 w-10 rounded-full bg-white/20"></span>
    </span>
    <span class="flex items-center gap-2">
      <span class="h-1 w-6 rounded-full bg-white/10"></span>
      <span class="h-1 w-6 rounded-full bg-white/10"></span>
      <span class="h-3 w-8 rounded-full bg-accent/60"></span>
    </span>
  </div>

  <div class="flex flex-1 items-center justify-center rounded-b-md border border-line bg-white/[0.02] p-3">
    <div class="w-36 rounded-lg border border-accent/30 bg-surface/90 p-2.5 text-center shadow-[0_0_24px_var(--color-glow)]">
      <p class="font-mono text-[7px] tracking-[0.2em] text-accent-cyan uppercase">Pro</p>
      <p class="mt-1 font-heading text-base font-semibold text-fg">$29<span class="text-[9px] text-fg-muted">/mo</span></p>
      <div class="mt-2 space-y-1">
        {
          features.map((f) => (
            <p class="flex items-center justify-center gap-1 text-[7px] text-fg-muted">
              <span class="h-1 w-1 rounded-full bg-accent-cyan" /> {f}
            </p>
          ))
        }
      </div>
      <div class="mt-2 h-4 rounded-md bg-gradient-to-r from-accent to-accent-cyan"></div>
    </div>
  </div>
</div>
