---
import { cn } from "../../../lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div aria-hidden="true" class={cn("flex h-full flex-col justify-end gap-2 p-4", className)}>
  <div class="flex items-center gap-1.5 rounded-md border border-line bg-white/[0.02] px-2.5 py-1.5">
    <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent-cyan"></span>
    <span class="h-1 w-2/3 rounded-full bg-white/10"></span>
  </div>

  <div class="ml-auto max-w-[85%] self-end rounded-md rounded-tr-sm border border-line bg-white/[0.03] px-2.5 py-1.5">
    <span class="h-1 block w-24 rounded-full bg-white/15"></span>
  </div>

  <div class="max-w-[85%] rounded-md rounded-tl-sm border border-accent/30 bg-accent/10 px-2.5 py-2">
    <span class="block h-1 w-28 rounded-full bg-white/20"></span>
    <span class="mt-1.5 block h-1 w-20 rounded-full bg-white/10"></span>
    <div class="mt-2 flex gap-1">
      <span class="rounded-sm border border-line bg-ink/60 px-1.5 py-0.5 font-mono text-[7px] tracking-wide text-accent-cyan">
        [1]
      </span>
      <span class="rounded-sm border border-line bg-ink/60 px-1.5 py-0.5 font-mono text-[7px] tracking-wide text-accent-cyan">
        [2]
      </span>
    </div>
  </div>
</div>
